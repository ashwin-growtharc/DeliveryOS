{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "deliveryos",
  "version": "0.1.0",
  "identifier": "com.growtharc.deliveryos.spike",
  "build": {
    "frontendDist": "spike-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeliveryOS",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../build/deliveryos-engine"
    ],
    "resources": {
      "../build/esbuild.exe": "esbuild.exe",
      "../build/deliveryos-cli.exe": "deliveryos.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/path-hook.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyOTBBODAzOUE0MTgyMEIKUldRTGdrR2FBNmlRd2lzRHlka1NOSVNUY005VFlIZytNTVoyWHhFUGFzT1hFQXljWmYzR0Z3Y3QK",
      "endpoints": [
        "https://github.com/ashwin-growtharc/DeliveryOS/releases/latest/download/latest.json"
      ]
    }
  }
}
