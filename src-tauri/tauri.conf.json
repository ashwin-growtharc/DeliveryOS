{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "deliveryos",
  "version": "0.1.0",
  "identifier": "com.growtharc.deliveryos.spike",
  "build": {
    "frontendDist": "spike-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeliveryOS",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../build/deliveryos-engine"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
