{
  "name": "deliveryos",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "deliveryos": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs",
    "prebuild": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "pretypecheck": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "pretest": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs",
    "test": "vitest run",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "generate:vendored-react": "node scripts/generate-vendored-react-runtime.mjs",
    "generate:vendored-libraries": "node scripts/generate-vendored-libraries.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "commander": "^12.1.0",
    "esbuild": "^0.28.1",
    "ignore": "^7.0.6",
    "react": "^19.2.8",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.8",
    "simple-git": "^3.27.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.14.0",
    "framer-motion": "^12.43.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
