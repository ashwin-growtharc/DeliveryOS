{
  "name": "deliveryos",
  "version": "0.1.2",
  "private": true,
  "bin": {
    "deliveryos": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs && node scripts/generate-vendored-tailwind-preflight.mjs && node scripts/generate-vendored-marked.mjs && node scripts/generate-vendored-xterm.mjs && node scripts/generate-vendored-fonts.mjs",
    "prebuild": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs && node scripts/generate-vendored-tailwind-preflight.mjs && node scripts/generate-vendored-marked.mjs && node scripts/generate-vendored-xterm.mjs && node scripts/generate-vendored-fonts.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "pretypecheck": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs && node scripts/generate-vendored-tailwind-preflight.mjs && node scripts/generate-vendored-marked.mjs && node scripts/generate-vendored-xterm.mjs && node scripts/generate-vendored-fonts.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "pretest": "node scripts/generate-vendored-react-runtime.mjs && node scripts/generate-vendored-libraries.mjs && node scripts/generate-vendored-tailwind-preflight.mjs && node scripts/generate-vendored-marked.mjs && node scripts/generate-vendored-xterm.mjs && node scripts/generate-vendored-fonts.mjs",
    "test": "vitest run",
    "ui:contrast": "node scripts/ui/audit-contrast.mjs",
    "ui:themes": "node scripts/ui/check-theme-matrix.mjs",
    "ui:fonts": "node scripts/ui/check-fonts-offline.mjs",
    "lint:css": "node scripts/ui/lint-tokens.mjs",
    "ui:screenshots": "node scripts/ui/screenshot-views.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "generate:vendored-react": "node scripts/generate-vendored-react-runtime.mjs",
    "generate:vendored-libraries": "node scripts/generate-vendored-libraries.mjs",
    "generate:vendored-tailwind-preflight": "node scripts/generate-vendored-tailwind-preflight.mjs",
    "generate:vendored-marked": "node scripts/generate-vendored-marked.mjs",
    "generate:vendored-xterm": "node scripts/generate-vendored-xterm.mjs",
    "generate:vendored-fonts": "node scripts/generate-vendored-fonts.mjs",
    "walkthrough": "node scripts/walkthrough/capture.mjs && node scripts/walkthrough/build.mjs && node scripts/walkthrough/shots.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "commander": "^12.1.0",
    "esbuild": "^0.28.1",
    "ignore": "^7.0.6",
    "marked": "^18.0.9",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.25",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.8",
    "sigstore": "^4.1.1",
    "simple-git": "^3.27.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sigstore/mock": "^0.12.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tufjs/repo-mock": "^4.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.14.0",
    "framer-motion": "^12.43.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.28.0",
    "prettier": "^3.3.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
